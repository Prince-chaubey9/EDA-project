RCB= data[data['batting_team']=='Royal Challengers Bangalore']
RCB = RCB.fillna(0)
RCB= RCB[RCB['player_dismissed']!= 0]

# wicket loss in first 6 overs 

RCB_first6= RCB[RCB['over']<=6]
RCB_first6= RCB_first6.groupby('match_id')['player_dismissed'].count()
RCB_first6=pd.DataFrame(RCB_first6)
RCB_first6=RCB_first6.reset_index().sort_values('player_dismissed',ascending=False).head(100)
RCB_first6= RCB_first6.rename(columns={'player_dismissed':'first 6'})
RCB_first6


# wicket loos in 7 to 15 over  
RCB_first15= RCB[(RCB['over']>6) & (RCB['over']<=15)]
RCB_first15= RCB_first15.groupby('match_id')['player_dismissed'].count()
RCB_first15=pd.DataFrame(RCB_first15)
RCB_first15=RCB_first15.reset_index().sort_values('player_dismissed',ascending=False).head(100)
RCB_first15= RCB_first15.rename(columns={'player_dismissed':'7 to 15'})
RCB_first15


# last  5 overs 

RCB_last6= RCB[RCB['over']>15]
RCB_last6= RCB_last6.groupby('match_id')['player_dismissed'].count()
RCB_last6=pd.DataFrame(RCB_last6)
RCB_last6=RCB_last6.reset_index().sort_values('player_dismissed',ascending=False).head(100)
RCB_last6= RCB_last6.rename(columns={'player_dismissed':'last 5 over'})

RCB_last6


 # now merge all three data Frame on the bassis of inex means match id


wicket_fall= pd.merge(pd.merge(RCB_first6,RCB_first15, on='match_id'),RCB_last6,on='match_id').head(13)
wicket_fall


 # wicket fall analysis when rcb loos its max wicket in first 6 over , mid over and last overs 
plt.figure(figsize=(14,5))
x= np.arange(len(wicket_fall['match_id']))
first= plt.bar(x-0.3,wicket_fall['first 6'], 0.3, label=' first 6')
mid= plt.bar(x,wicket_fall['7 to 15'], 0.3,color='r', label=' mid over')
last=plt.bar(x+0.3,wicket_fall['first 6'], 0.3,color='y', label=' last 5 ')
plt.bar_label(first)
plt.bar_label(mid)
plt.bar_label(last)
plt.legend()
plt.xticks(x,wicket_fall['match_id'])
plt.title(' RCB max wicket loss in a bracket in singel match',fontweight='bold')
plt.show()





